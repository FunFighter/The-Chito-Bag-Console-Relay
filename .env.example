# Copy to .env on the host. Never commit it.

# --- Discord --------------------------------------------------------------
# Bot token from the Developer Portal. Also enable the MESSAGE CONTENT intent
# there if BRIDGE_TO_GAME is true, or login fails outright.
DISCORD_TOKEN=

# Channels the bot accepts slash commands from. Required -- with this empty
# the bot refuses to start rather than answer everywhere.
COMMAND_CHANNEL_IDS=

# Where server events are mirrored (joins, deaths, advancements, errors).
CONSOLE_CHANNEL_ID=

# Two-way chat bridge. Messages here are relayed into the game, and in-game
# chat is relayed back. Leave BRIDGE_TO_GAME=false to keep it one-way.
BRIDGE_CHANNEL_ID=
BRIDGE_TO_GAME=false

# Every command attempt, allowed or refused, is logged here.
AUDIT_CHANNEL_ID=

# --- Permissions ----------------------------------------------------------
# Admin is by user id, not role: tier 2 can op, ban and stop the server.
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
MOD_ROLE_IDS=

# --- Server ---------------------------------------------------------------
MC_DATA_DIR=/srv/chitobag/data
RCON_HOST=chitobag-server
RCON_PORT=25575

# --- Limits ---------------------------------------------------------------
RATE_PER_USER=8
RATE_WINDOW=60
