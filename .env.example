# Copy to .env on the host. Never commit it.

# --- Discord --------------------------------------------------------------
# Bot token from the Developer Portal. Also enable the MESSAGE CONTENT intent
# there if BRIDGE_TO_GAME is true, or login fails outright.
DISCORD_TOKEN=

# Channels the bot accepts slash commands from. Required -- with this empty
# the bot refuses to start rather than answer everywhere.
COMMAND_CHANNEL_IDS=

# Where server events are mirrored (joins, deaths, advancements, errors).
CONSOLE_CHANNEL_ID=

# Two-way chat bridge. Messages here are relayed into the game, and in-game
# chat is relayed back. Leave BRIDGE_TO_GAME=false to keep it one-way.
BRIDGE_CHANNEL_ID=
BRIDGE_TO_GAME=false

# Every command attempt, allowed or refused, is logged here.
AUDIT_CHANNEL_ID=

# --- Permissions ----------------------------------------------------------
# Tier 2 can op, ban and stop the server. At least one admin grant is required
# or the bot refuses to start.
#
# Usernames are convenient but MUTABLE -- Discord lets anyone change their
# handle, and a freed handle can be claimed by someone else. User IDs are
# permanent. Collect the IDs (Developer Mode on, right-click a user, Copy User
# ID) and move the grants to ADMIN_USER_IDS when you get the chance.
ADMIN_USERNAMES=
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=
MOD_USERNAMES=
MOD_ROLE_IDS=

# --- Server ---------------------------------------------------------------
# Must match the owner of MC_DATA_DIR -- .rcon_password is mode 600.
# On wonton that is the `minecraft` service account.
PUID=1001
PGID=1001

MC_DATA_DIR=/srv/chitobag/data
RCON_HOST=chitobag-server
RCON_PORT=25575

# --- Limits ---------------------------------------------------------------
RATE_PER_USER=8
RATE_WINDOW=60
